{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types"],
    "outDir": "./build"
  },
  "include": [
    "src/**/*",
    "frontend/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
