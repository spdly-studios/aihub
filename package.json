{
  "name": "spdly-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SPDLY AI — Personal AI Workstation & Multi-Provider Gateway",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"wrangler dev\" \"vite dev\"",
    "dev:worker": "wrangler dev",
    "dev:ui": "vite dev",
    "build": "vite build && wrangler deploy --dry-run",
    "build:ui": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "@types/node": "^26.6.3",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wrangler": "^3.80.0"
  }
}
